# Copy to .env (gitignored) and fill in. Never commit real values.
#
# The repository is public: a committed credential is immediately exploitable.
# Secrets belong in the host's environment, not in a file in the repo.

# Supabase project. The anon key is designed to be public and may appear in the
# iOS client; the service-role key must never leave this backend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Milestone 4. Without this, strategy and caption generation use a clearly
# labelled mock and the /capabilities endpoint reports it as such.
ANTHROPIC_API_KEY=

# Milestone 3. Needed for real place matching.
GOOGLE_MAPS_API_KEY=
